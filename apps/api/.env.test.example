# Copy to .env.test (git-ignored) before running the API suite.
#
#   cp apps/api/.env.test.example apps/api/.env.test
#
# THE SUITE TRUNCATES EVERY TABLE IN THIS DATABASE between tests, so point it at a
# scratch one and never at anything you want to keep. Nothing here is a secret; the
# test setup also lets real environment variables win over this file, which is how
# CI supplies its own.
NODE_ENV=test

# The docker-compose Postgres, with a separate database for tests.
#   docker compose up -d postgres
#   docker compose exec postgres createdb -U snaptab snaptab_test
DATABASE_URL=postgresql://snaptab:snaptab@localhost:5432/snaptab_test?schema=public

# Long enough to satisfy the config check, and worthless to anyone.
JWT_SECRET=test-secret-test-secret-test-secret-test-secret

# Fixed output, no credentials, no network. The suite depends on it being the stub.
OCR_PROVIDER=stub

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage-test
LOG_LEVEL=silent
PUBLIC_BASE_URL=http://localhost:4000
APP_SHARE_BASE_URL=http://localhost:4000/t

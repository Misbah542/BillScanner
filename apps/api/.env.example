# ---- core ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
PUBLIC_BASE_URL=http://localhost:4000
APP_SHARE_BASE_URL=http://localhost:4000/t

# ---- database ----
DATABASE_URL=postgresql://snaptab:snaptab@localhost:5432/snaptab?schema=public

# ---- auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=60
OTP_TTL_SECONDS=600
# Google OAuth client id the Android app signs in with. Leave blank to disable
# Google sign-in; /v1/auth/google then returns 501 rather than failing obscurely.
GOOGLE_CLIENT_IDS=

# ---- receipt scanning ----
# stub | google-vision | textract.  `stub` needs no credentials and is what the
# tests and a fresh checkout use.
OCR_PROVIDER=stub
GOOGLE_VISION_API_KEY=
SCAN_MAX_BYTES=12582912

# ---- storage ----
# local | s3
#
# `local` writes receipts to the filesystem. That is fine on your machine and on a VM with
# a disk, and wrong on anything serverless (Cloud Run, App Runner, Fargate), where the
# filesystem goes away with the instance and the loss is silent until someone reopens an
# old expense. Use `s3` there.
#
# The s3 driver talks to any S3-compatible store, so the same settings cover AWS S3,
# Google Cloud Storage (via its HMAC keys) and Oracle Object Storage. See docs/DEPLOY.md.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_BUCKET=
S3_REGION=
# Leave blank for AWS. Required for GCS and Oracle.
S3_ENDPOINT=
# Leave blank on EC2/ECS/GKE and let the instance role or workload identity supply them —
# then there is no key to store or rotate at all.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Defaults to true whenever S3_ENDPOINT is set, which is what non-AWS stores need.
S3_FORCE_PATH_STYLE=

# ---- push ----
# Leave blank in development; notifications are then written to the DB only.
FCM_SERVER_KEY=

# ---- outbound messages ----
# Leave blank to print OTPs to the log instead of sending them.
SMTP_URL=
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

## Copy to local.properties (git-ignored) and fill in your own values.
## Nothing here is committed, and every key has a working default except sdk.dir.

# Where your Android SDK lives. Android Studio writes this for you on first sync.
sdk.dir=/Users/you/Library/Android/sdk

# Base URL of the SnapTab API, trailing slash included.
#   10.0.2.2  is the host machine as seen from the Android emulator
#   localhost inside the emulator is the emulator itself, not your Mac
# Defaults to http://10.0.2.2:4000/ when unset.
snaptab.apiBaseUrl=http://10.0.2.2:4000/

# OAuth client id for Google sign-in, from the Google Cloud console
# (type: Android, with this app's package name and signing certificate SHA-1).
# Leave blank and the sign-in screen simply does not offer Google.
snaptab.googleClientId=

{
  "version": 2,
  "note": "Bank-alert parsing rules, shared between the TypeScript parser (apps/api) and the Kotlin one (apps/android). Rules are composed rather than one monolithic regex per bank: reject, then find direction, amount, account, merchant, reference. Patterns use named groups, which behave the same in JS and Java regex. Case-insensitive throughout.",
  "reject": [
    "\\botp\\b",
    "\\bone[ -]?time (?:password|pin)\\b",
    "do not share",
    "\\bwill be (?:debited|deducted|charged)\\b",
    "\\bis due\\b",
    "\\bdue on\\b",
    "\\bhas been requested\\b",
    "\\bcollect request\\b",
    "\\brequest(?:ed)? (?:money|payment) from\\b",
    "\\be-?mandate\\b",
    "\\bregistered for\\b",
    "\\bfailed\\b",
    "\\bdeclined\\b",
    "\\breversed\\b",
    "\\bmin(?:imum)? (?:amount )?due\\b",
    "\\bstatement\\b",
    "\\bapply now\\b",
    "\\bpre-?approved\\b",
    "\\boffer\\b.*\\bclick\\b",
    "\\bcashback of\\b.*\\bwill\\b",
    "\\bwin\\b.*\\bvoucher\\b",
    "\\bt&c\\b.*\\bapply\\b.*\\bclick\\b",
    "^\\s*(?:dear (?:customer|sir|madam),?\\s*)?(?:your )?(?:a\\/c|account|avl|available)\\b[^.]*\\bbalance\\b[^.]*\\bis\\b"
  ],
  "debitMarkers": [
    "\\bdebited\\b",
    "\\bdebit\\b",
    "\\bspent\\b",
    "\\bwithdrawn\\b",
    "\\bpaid to\\b",
    "\\bsent\\b",
    "\\bsent rs\\b",
    "\\btransferred to\\b",
    "\\bpurchase of\\b",
    "\\btxn of\\b.*\\bon your\\b.*\\bcard\\b",
    "\\bhas been used for\\b",
    "\\bpaid\\b",
    "\\bdebited from\\b",
    "\\btxn of\\b",
    "\\bpayment of\\b.*\\bsuccessful\\b"
  ],
  "creditMarkers": [
    "\\bcredited\\b",
    "\\bcredit\\b",
    "\\breceived\\b",
    "\\bdeposited\\b",
    "\\brefund(?:ed)?\\b",
    "\\bcashback credited\\b",
    "\\bsalary\\b",
    "\\badded to\\b"
  ],
  "amount": [
    "(?:rs\\.?|inr|₹)\\s*(?<amount>\\d{1,3}(?:,\\d{2,3})+(?:\\.\\d{1,2})?|\\d+(?:\\.\\d{1,2})?)",
    "(?<amount>\\d{1,3}(?:,\\d{2,3})+(?:\\.\\d{1,2})?|\\d+(?:\\.\\d{1,2})?)\\s*(?:rs\\.?|inr|₹)"
  ],
  "account": [
    "(?:a\\/c|ac|acct|account)\\s*(?:no\\.?)?\\s*(?:x+|\\*+)?(?<mask>\\d{3,6})\\b",
    "(?:card|cc|debit card|credit card)\\s*(?:no\\.?)?\\s*(?:x+|\\*+)?(?<mask>\\d{3,6})\\b",
    "\\bx{2,}(?<mask>\\d{3,6})\\b"
  ],
  "merchant": [
    "\\b(?:at|to|towards)\\s+(?<merchant>[A-Za-z0-9][A-Za-z0-9 .&'\\-*@_]{2,48}?)\\s*(?:\\bon\\b|\\bvia\\b|\\bfor\\b|\\bfrom\\b|\\busing\\b|\\bref\\b|\\bupi\\b|\\byour\\b|\\bavl\\b|\\bbal\\b|\\bcard\\b|\\bnot you\\b|[.;,]|$)",
    "\\b(?:from)\\s+(?<merchant>[A-Za-z0-9][A-Za-z0-9 .&'\\-*@_]{2,48}?)\\s*(?:\\bon\\b|\\bvia\\b|\\bref\\b|\\bupi\\b|[.;,]|$)",
    "\\b(?:info|desc|narration|remarks?)\\s*[:\\-]\\s*(?<merchant>[^.;,\\n]{3,48})",
    "\\bvpa\\s+(?<merchant>[A-Za-z0-9.\\-_]{3,48}@[A-Za-z]{2,24})",
    "\\b(?<merchant>[A-Za-z0-9.\\-_]{3,32}@(?:okhdfcbank|okaxis|oksbi|okicici|ybl|paytm|apl|ibl|upi|axl))\\b"
  ],
  "reference": [
    "(?:upi )?(?:ref(?:erence)?(?: no\\.?| number)?|rrn|txn id|transaction id|trn)\\s*[:#\\-]?\\s*(?<ref>[A-Za-z0-9]{6,24})\\b",
    "\\bupi[/:\\- ](?<ref>\\d{9,20})\\b"
  ],
  "balance": [
    "(?:avl(?:\\.| )?(?:bal|balance)|available balance|bal(?:ance)?)\\s*[:\\-]?\\s*(?:rs\\.?|inr|₹)?\\s*(?<balance>\\d{1,3}(?:,\\d{2,3})+(?:\\.\\d{1,2})?|\\d+(?:\\.\\d{1,2})?)"
  ],

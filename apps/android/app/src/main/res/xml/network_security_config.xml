<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere. The two exceptions are the loopback addresses a developer's
  local API runs on (10.0.2.2 is the host as seen from the emulator), and they are
  scoped to the debug build only by virtue of being the only cleartext permits.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

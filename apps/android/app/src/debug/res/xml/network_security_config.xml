<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only — this file replaces the one in src/main, which permits no
  cleartext at all.

  Development APIs run on plain HTTP over loopback. 10.0.2.2 is the host machine
  as seen from the Android emulator; 127.0.0.1 is the device itself, reached over
  `adb reverse`. Everything else still requires HTTPS, so a debug build cannot be
  quietly downgraded to cleartext against a real server either.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

# ---- Node / monorepo ----
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.turbo/
.env
.env.*
# The only exceptions are the templates: placeholders that name the variables and
# carry no values. A real value belongs to the environment that runs the code, or
# to GitHub Actions secrets — never to the repository.
!.env.example
!.env.test.example
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- Android / Gradle ----
.gradle/
apps/android/local.properties

# Credentials that arrive as downloaded files. google-services.json is not a secret in
# the strict sense — it ships inside the APK — but client_secret_*.json is, and both
# land in a Downloads folder with a name that invites dragging them into the project.
# A public repository is not the place to find out which of the two you moved.
apps/android/app/google-services.json
apps/android/app/*/google-services.json
google-services.json
client_secret*.json
*.jks
*.keystore
apps/android/app/build/
apps/android/build/
captures/
*.apk
*.aab
*.keystore
*.jks
!debug.keystore
.cxx/

# ---- Prisma / db ----
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# ---- Uploads (local storage driver) ----
apps/api/.storage/
apps/api/.storage-test/

# ---- IDE / OS ----
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
